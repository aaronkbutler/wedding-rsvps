# HTTP
PORT=8080
ALLOWED_ORIGINS=*

# Google Sheets
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here
# Optional for local/dev. In Cloud Run, prefer runtime service account (ADC).
# GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account",...}

# RSVP behavior
SEND_CONFIRMATION_EMAILS=true
MEAL_OPTIONS=Apricot Glazed Salmon (gluten-free)|Wild Mushroom Strudel (dairy)
EVENTS_WHERE_ZERO_MEANS_EVERYONE=sunday
GUEST_LIST_NON_EVENT_COLUMNS=zip code,invitation,hospitality,contact,first line,second line,city/town,state,and family or someone else,formatted address,print,column 1,additional guests
ADDITIONAL_GUESTS_COLUMN=additional guests

# Email (Gmail SMTP app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@gmail.com
SMTP_PASS=your_16_char_app_password
CONFIRMATION_EMAIL_SUBJECT=Raquel and Aaron's Wedding RSVP Confirmation
CONFIRMATION_EMAIL_SENDER_NAME=Raquel and Aaron
WEDDING_WEBSITE_URL=https://raquelandaaron.com
CONFIRMATION_EMAIL_RECIPIENTS=
